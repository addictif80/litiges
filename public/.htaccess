# --- Reecriture vers le front controller ------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS (decommentez en production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Ne pas reecrire les fichiers et repertoires existants
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

# --- En-tetes de securite ---------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- Interdiction d'acces aux fichiers sensibles ----------------------
<FilesMatch "\.(sql|md|json|lock|example\.php|ini|log)$">
    Require all denied
</FilesMatch>

# --- Taille des uploads -----------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>

Options -Indexes
